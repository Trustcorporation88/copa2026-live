# =============================================================================
# Copa 2026 Live — variáveis de ambiente
# Copie para .env:  copy env.example .env
# (Este arquivo é cópia de .env.example — alguns editores ocultam arquivos com ".")
# =============================================================================

# Servidor
PORT=5000
NODE_ENV=development
# LOG_LEVEL=info

# football-data.org — calendário e placares base
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# API-Football Pro (api-sports.io) — stats ao vivo: escanteios, cartões, chutes, posse
# https://www.api-football.com/
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUE_ID=1
API_FOOTBALL_SEASON=2026

# TheSportsDB — badges, timeline, bridge para API-Football
# Use 123,3 — key 123 traz os 72 jogos da Copa; key 3 só ~5
THESPORTSDB_API_KEYS=123,3
